{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["jest", "node"],
        "paths": {
            "@dal/*": ["./src/dal/*"],
            "@controllers/*": ["./src/controllers/*"],
            "@routes/*": ["./src/routes/*"],
            "@middleware/*": ["./src/middleware/*"],
            "@models/*": ["./src/models/*"],
            "@utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"]
}